+def test_menu_button_positions_fully_visible(window):
+    from game import TelaMenu, HEIGHT
+
+    m = TelaMenu()
+    window.show_view(m)
+    for b in m.ui.buttons:
+        # bottom >= 0, top <= HEIGHT
+        assert b.rect.bottom >= 0, f"Button {b.id} bottom {b.rect.bottom} < 0"
+        assert b.rect.top <= HEIGHT, f"Button {b.id} top {b.rect.top} > {HEIGHT}"
+        # width/height positive
+        assert b.rect.width > 0
+        assert b.rect.height > 0
+    # Verify uniform vertical spacing (gap = 12)
+    ys = [b.rect.bottom for b in m.ui.buttons]
+    gaps = [ys[i] - ys[i+1] for i in range(len(ys)-1)]
+    # All gaps should be equal (button_h + gap = 64 + 12 = 76)
+    assert all(abs(g - 76) < 1 for g in gaps), f"Non-uniform gaps: {gaps}"
+
